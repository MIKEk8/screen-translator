<Page x:Class="ScreenTranslator.App.Pages.TranslatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Headers -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="SourceLabel" Text="Source" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceLangCombo"
                          Style="{StaticResource DarkComboBox}"
                          Margin="8,0,0,0" MinWidth="60" Padding="6,3"
                          FontSize="11" FontWeight="Bold"
                          SelectionChanged="SourceLangCombo_SelectionChanged"/>
                <Button x:Name="SpeakSourceButton" Content="&#x1F50A;"
                        Style="{StaticResource AccentButton}"
                        Background="Transparent" FontSize="14"
                        Padding="6,2" Margin="6,0,0,0"
                        ToolTip="Speak source text"
                        Click="SpeakSourceButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TranslationLabel" Text="Translation" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetLangCombo"
                          Style="{StaticResource DarkComboBox}"
                          Margin="8,0,0,0" MinWidth="60" Padding="6,3"
                          FontSize="11" FontWeight="Bold"
                          SelectionChanged="TargetLangCombo_SelectionChanged"/>
                <Button x:Name="SpeakTargetButton" Content="&#x1F50A;"
                        Style="{StaticResource AccentButton}"
                        Background="Transparent" FontSize="14"
                        Padding="6,2" Margin="6,0,0,0"
                        ToolTip="Speak translation"
                        Click="SpeakTargetButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Text Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <TextBox x:Name="SourceTextBox"
                             Style="{StaticResource DarkTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             FontSize="15"/>
                    <Image x:Name="SourceImage"
                           Visibility="Collapsed"
                           Stretch="Uniform" Margin="4"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TextBox x:Name="TargetTextBox"
                         Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         BorderThickness="0" Background="Transparent"
                         FontSize="15"/>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="CaptureButton" Content="&#x1F4F7; Capture"
                        Style="{StaticResource AccentButton}"
                        Click="CaptureButton_Click"/>
                <ComboBox x:Name="OcrCombo"
                          Style="{StaticResource DarkComboBox}"
                          Margin="6,0,0,0" MinWidth="90" Padding="6,3"
                          FontSize="11"
                          ToolTip="OCR engine"
                          SelectionChanged="OcrCombo_SelectionChanged"/>

                <Button x:Name="TranslateButton" Content="Translate"
                        Style="{StaticResource AccentButton}"
                        Click="TranslateButton_Click" Margin="14,0,0,0"
                        Background="{StaticResource BgTertiaryBrush}"/>
                <ComboBox x:Name="ProviderCombo"
                          Style="{StaticResource DarkComboBox}"
                          Margin="6,0,0,0" MinWidth="90" Padding="6,3"
                          FontSize="11"
                          ToolTip="Translation provider"
                          SelectionChanged="ProviderCombo_SelectionChanged"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="Ready"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
