<Page x:Class="ScreenTranslator.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="640">

            <TextBlock x:Name="AboutTitleText" Text="About" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

            <!-- App Info -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Image Source="/icon.ico" Width="48" Height="48" Margin="0,0,14,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Screen Translator" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="DescriptionText" Text="Desktop app for screen capture, OCR text recognition, and real-time translation."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BuildTimeLbl" Text="Build time" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="BuildTimeText" Grid.Column="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RuntimeLbl" Text="Runtime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="RuntimeText" Grid.Column="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlatformLbl" Text="Platform" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="PlatformText" Grid.Column="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckUpdatesBtn" Content="Check for updates"
                                Click="CheckUpdates_Click"
                                Style="{StaticResource AccentButton}"
                                Background="{StaticResource BgTertiaryBrush}"
                                Padding="14,6" FontSize="12"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button x:Name="UpdateBtn" Content="Update" Visibility="Collapsed"
                                Click="Update_Click"
                                Style="{StaticResource AccentButton}"
                                Padding="14,6" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100"
                                     Background="{StaticResource BgTertiaryBrush}"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadProgressText" Grid.Column="1"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What's New -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="WhatsNewSectionText" Text="WHAT'S NEW IN v1.5" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="WhatsNewText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">v1.5.0</Run>
                        <Run>— Security, architecture &amp; UX</Run>
                        <LineBreak/>
                        <Run>&#x2022; API keys encrypted at rest (DPAPI)</Run>
                        <LineBreak/>
                        <Run>&#x2022; Hotkey validation with error hints</Run>
                        <LineBreak/>
                        <Run>&#x2022; F1–F12 function keys support in hotkeys</Run>
                        <LineBreak/>
                        <Run>&#x2022; DeepInfra TTS connection test button</Run>
                        <LineBreak/>
                        <Run>&#x2022; Translation throttle &amp; memory leak fix</Run>
                        <LineBreak/>
                        <Run>&#x2022; DI factories for translation providers</Run>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">v1.4.0</Run>
                        <Run>— TTS &amp; screenshot</Run>
                        <LineBreak/>
                        <Run>&#x2022; OpenAI-compatible &amp; DeepInfra TTS providers</Run>
                        <LineBreak/>
                        <Run>&#x2022; Screenshot hotkey (Alt+S) with preview window</Run>
                        <LineBreak/>
                        <Run>&#x2022; Gesture passthrough &amp; pause/resume hotkeys</Run>
                        <LineBreak/>
                        <Run>&#x2022; Auto-update, autostart, start minimized</Run>
                        <LineBreak/>
                        <Run>&#x2022; Notification volume control</Run>
                        <LineBreak/>
                        <Run>&#x2022; Reset settings confirmation dialog</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Stack -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TechSectionText" Text="TECHNOLOGY" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">UI:</Run>
                        <Run>WPF (.NET 9, C#)</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">OCR:</Run>
                        <Run>Windows.Media.Ocr (WinRT), Tesseract, Vision (LLM)</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">Translation:</Run>
                        <Run>Google, OpenAI-compatible, Ollama</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">TTS:</Run>
                        <Run>SAPI5, OpenAI-compatible, DeepInfra</Run>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">MVVM:</Run>
                        <Run>CommunityToolkit.Mvvm</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Hotkeys Reference -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="HotkeysSectionText" Text="HOTKEYS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alt+A" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyCaptureLbl" Grid.Column="1" Text="Capture screen area and translate"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alt+C" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyCopyLbl" Grid.Column="1" Text="Copy selected text and translate"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alt+X" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyStopLbl" Grid.Column="1" Text="Stop speech"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alt+S" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyScreenshotLbl" Grid.Column="1" Text="Screenshot current monitor"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mouse Gesture -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="GestureSectionText" Text="MOUSE GESTURE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="GestureDescText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Hold a mouse side button (XButton) and draw a circle or oval around text on screen. The enclosed area will be captured, recognized, and translated automatically."/>
                    <TextBlock x:Name="GestureConfigText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Configure the mouse button and enable/disable in Settings." Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Author -->
            <TextBlock x:Name="FooterText" Text="Personal project" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

        </StackPanel>
    </ScrollViewer>
</Page>
