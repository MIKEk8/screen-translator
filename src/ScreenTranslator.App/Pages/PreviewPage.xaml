<Page x:Class="ScreenTranslator.App.Pages.PreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Capture Preview" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border x:Name="RegionInfoBadge" Background="{StaticResource BgTertiaryBrush}"
                        CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RegionInfoText" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#x1F4F7;  Capture Area"
                        Style="{StaticResource AccentButton}"
                        Click="CaptureButton_Click" Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- Image Preview -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <!-- Placeholder when no image -->
                <StackPanel x:Name="PlaceholderPanel"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#x1F5BC;" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="No capture yet" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Click 'Capture Area' or press Alt+A"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.6"/>
                </StackPanel>

                <!-- Actual image -->
                <ScrollViewer x:Name="ImageScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <Grid>
                        <!-- Checkerboard background for transparency -->
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               MouseWheel="PreviewImage_MouseWheel"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom info bar -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="OcrResultText" Text=""
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="500"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Fit" Style="{StaticResource AccentButton}"
                        Background="{StaticResource BgTertiaryBrush}"
                        Click="FitButton_Click" Padding="10,4" FontSize="11"/>
                <Button Content="1:1" Style="{StaticResource AccentButton}"
                        Background="{StaticResource BgTertiaryBrush}"
                        Click="ActualSizeButton_Click" Padding="10,4" FontSize="11"
                        Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
