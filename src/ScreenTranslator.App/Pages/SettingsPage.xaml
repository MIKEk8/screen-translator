<Page x:Class="ScreenTranslator.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="640">

            <!-- Page Title -->
            <TextBlock x:Name="TitleText" Text="Settings" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

            <!-- ═══ Application ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="AppSectionText" Text="APPLICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <CheckBox x:Name="AutostartCheckBox" Content="Launch at Windows startup"
                              IsChecked="{Binding AutostartEnabled}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13" Margin="0,0,0,10"/>

                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray"
                              IsChecked="{Binding StartMinimized}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ═══ Language ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="LangSectionText" Text="LANGUAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InterfaceLangText" Text="Interface language" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableInterfaceLanguages}"
                                  SelectedItem="{Binding SelectedInterfaceLanguage}"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>

                    <Button x:Name="ValidateButton" Content="Validate translations"
                            Command="{Binding ValidateTranslationsCommand}"
                            Style="{StaticResource AccentButton}"
                            Background="{StaticResource BgTertiaryBrush}"
                            Padding="14,6" FontSize="12" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ═══ Translation Provider ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TranslationSectionText" Text="TRANSLATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProviderText" Text="Provider" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OcrEngineText" Text="OCR Engine" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OcrEngines}"
                                  SelectedItem="{Binding SelectedOcrEngine}"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>

                    <!-- OpenAI Compatible section -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProvider}" Value="OpenAiCompatible">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8"
                                Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock x:Name="OpenAiTitleText" Text="OpenAI Compatible Settings" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <!-- Preset selector -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PresetText" Text="Preset" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding OpenAiPresets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource DarkComboBox}"/>
                                    <Button x:Name="AddPresetBtn" Grid.Column="2" Content="+" ToolTip="Add preset"
                                            Command="{Binding AddPresetCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Padding="8,4" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                    <Button x:Name="RemovePresetBtn" Grid.Column="3" Content="&#x2212;" ToolTip="Remove preset"
                                            Command="{Binding RemovePresetCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Background="#e74c3c"
                                            Padding="8,4" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NameText" Text="Name" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EndpointText" Text="Endpoint" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding OpenAiEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ApiKeyText" Text="API Key" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ModelText" Text="Model" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="ModelSearchBox"
                                                 Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"
                                                 GotFocus="ModelSearchBox_GotFocus"
                                                 TextChanged="ModelSearchBox_TextChanged"/>
                                        <Popup x:Name="ModelPopup"
                                               PlacementTarget="{Binding ElementName=ModelSearchBox}"
                                               Placement="Bottom" StaysOpen="False"
                                               Width="{Binding ActualWidth, ElementName=ModelSearchBox}">
                                            <Border Background="{StaticResource BgSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" MaxHeight="250">
                                                <ListBox x:Name="ModelListBox"
                                                         ItemsSource="{Binding FilteredModels}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         SelectionChanged="ModelList_SelectionChanged"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button x:Name="FetchModelsBtn" Grid.Column="2" Content="&#x1F504;"
                                            ToolTip="Fetch models from API"
                                            Command="{Binding FetchModelsCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Padding="8,4" FontSize="13" Margin="4,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="SystemPromptText" Text="System Prompt (optional, {source}/{target} placeholders)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding OpenAiSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>

                                <CheckBox x:Name="VisionCheckBox" Content="Vision mode (send screenshot directly, skip OCR)"
                                          IsChecked="{Binding UseVision}"
                                          Visibility="{Binding ShowVisionOption, Converter={StaticResource BoolToVisibility}}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          FontSize="12" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Ollama section -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProvider}" Value="Ollama">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource BgTertiaryBrush}" CornerRadius="8"
                                Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock x:Name="OllamaTitleText" Text="Ollama Settings" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OllamaEndpointText" Text="Endpoint" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OllamaModelText" Text="Model" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" FontSize="12" Padding="8,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Text-to-Speech ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TtsSectionText" Text="TEXT-TO-SPEECH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VoiceText" Text="Voice" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableVoices}"
                                  SelectedItem="{Binding SelectedVoice}"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SpeedText" Text="Speed" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="-10" Maximum="10"
                                Value="{Binding TtsRate}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TtsRate}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolumeText" Text="Volume" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                Value="{Binding TtsVolume}"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TtsVolume, StringFormat={}{0}%}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <CheckBox x:Name="AutoSpeakCheckBox" Content="Auto-speak translation"
                                  IsChecked="{Binding AutoSpeakTranslation}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="13"/>
                        <Button x:Name="TestVoiceBtn" Content="&#x25B6; Test" HorizontalAlignment="Right"
                                Command="{Binding TestVoiceCommand}"
                                Style="{StaticResource AccentButton}"
                                Background="{StaticResource BgTertiaryBrush}"
                                Padding="14,6" FontSize="12"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NotificationVolumeText" Text="Notification" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                Value="{Binding NotificationVolume}"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding NotificationVolume, StringFormat={}{0}%}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Hotkeys ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="HotkeysSectionText" Text="HOTKEYS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HotkeyCaptureText" Text="Capture" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1" Text="{Binding CaptureHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" FontSize="13" Padding="8,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HotkeyCopyText" Text="Copy &amp; Translate" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1" Text="{Binding CopyTranslateHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" FontSize="13" Padding="8,6"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HotkeyStopText" Text="Stop Speech" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1" Text="{Binding StopSpeechHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" FontSize="13" Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Mouse Gesture ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="GestureSectionText" Text="MOUSE GESTURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <CheckBox x:Name="GestureEnableCheckBox" Content="Enable mouse gesture capture"
                              IsChecked="{Binding GestureEnabled}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GestureButtonText" Text="Mouse button" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding MouseButtons}"
                                  SelectedValue="{Binding GestureMouseButton}"
                                  SelectedValuePath="Value"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Grid>

                    <TextBlock x:Name="GestureHintText" Text="Hold the mouse button and draw a circle around text to capture and translate"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ Overlay ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="OverlaySectionText" Text="OVERLAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <CheckBox x:Name="OverlayShowCheckBox" Content="Show overlay on translate"
                              IsChecked="{Binding ShowOverlayOnTranslate}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OpacityText" Text="Opacity" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="0.3" Maximum="1.0"
                                Value="{Binding OverlayOpacity}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FontSizeText" Text="Font size" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="10" Maximum="28"
                                Value="{Binding OverlayFontSize}"
                                TickFrequency="2" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OverlayFontSize, StringFormat={}{0}px}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Action Buttons ═══ -->
            <Grid Margin="0,8,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" FontSize="12"/>

                <Button x:Name="ResetButton" Grid.Column="1" Content="Reset to Defaults"
                        Click="ResetButton_Click"
                        Style="{StaticResource AccentButton}"
                        Background="{StaticResource BgTertiaryBrush}"
                        Padding="16,8"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
