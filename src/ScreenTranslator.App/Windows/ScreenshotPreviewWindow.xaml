<Window x:Class="ScreenTranslator.App.Windows.ScreenshotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Black"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Screenshot image -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Accent border to indicate this is a screenshot -->
        <Border BorderBrush="#7c5cfc" BorderThickness="3" Opacity="0.7"/>

        <!-- Hint bar at the top -->
        <Border Background="#CC1a1b2e" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0" Padding="16,8">
            <TextBlock x:Name="HintText"
                       Text="Screenshot — select area with Alt+A or mouse gesture. ESC to close."
                       Foreground="#e8e6f0" FontSize="13"
                       FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
